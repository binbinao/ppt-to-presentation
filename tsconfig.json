{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "noUncheckedIndexedAccess": true,
    "types": ["bun-types"],
    "skipLibCheck": true
  },
  "include": ["src", "tests"]
}
